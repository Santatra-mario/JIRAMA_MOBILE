@startuml
' JIRAMA ANTSIRABE - Diagramme global des cas d'utilisation
' Plateforme integree Web et mobile - version conceptuelle a valider

title 5.4.1 - Diagramme global des cas d'utilisation\nPlateforme integree JIRAMA Web et mobile
left to right direction

skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam nodesep 35
skinparam ranksep 42
skinparam ArrowColor #536B80
skinparam actorStyle stickman
skinparam packageBorderColor #8298AC
skinparam packageFontColor #17324D
skinparam usecase {
  BackgroundColor #F3F7FB
  BorderColor #0000
  FontColor #17324D
}

actor "Utilisateur authentifie" as UTIL
actor "Administrateur" as ADMIN
actor "Responsable" as RESP
actor "Agent de terrain" as AGENT

ADMIN --|> UTIL
RESP --|> UTIL
AGENT --|> UTIL

rectangle "PLATEFORME INTEGREE JIRAMA WEB ET MOBILE" as SYSTEM {
  package "Fonctions communes" {
    usecase "S'authentifier" as UC_AUTH
    usecase "Se deconnecter" as UC_LOGOUT
    usecase "Consulter son profil" as UC_PROFILE
    usecase "Modifier son mot de passe" as UC_PASSWORD
    usecase "Consulter les abonnes" as UC_ABONNES
    usecase "Consulter les compteurs" as UC_COMPTEURS
    usecase "Consulter les releves et l'historique" as UC_HISTO
    usecase "Consulter et analyser les anomalies" as UC_ANOMALIES
  }

  package "Web - Administration" {
    usecase "Gerer les comptes et les roles" as UC_USERS
    usecase "Gerer les abonnes" as UC_GEST_ABONNES
    usecase "Modifier les compteurs et leur statut" as UC_GEST_COMPTEURS
    usecase "Supprimer un releve" as UC_DELETE_RELEVE
    usecase "Definir le statut final d'une anomalie" as UC_STATUT_FINAL
  }

  package "Web - Supervision" {
    usecase "Creer une campagne de controle" as UC_CAMPAGNE
    usecase "Definir les dates de la campagne" as UC_DATES
    usecase "Affecter des agents" as UC_AFFECTER
    usecase "Ajouter des missions" as UC_MISSIONS
    usecase "Publier une campagne" as UC_PUBLIER
    usecase "Cloturer une campagne" as UC_CLOTURER
    usecase "Suivre l'avancement des missions" as UC_SUIVI_MISSION
    usecase "Consulter le tableau de bord" as UC_DASHBOARD
    usecase "Consulter les statistiques et comparaisons" as UC_STATS
    usecase "Creer ou modifier un releve" as UC_RELEVE_WEB
  }

  package "Mobile - Agent de terrain" {
    usecase "Consulter ses missions affectees" as UC_MISSION_AGENT
    usecase "Consulter le detail d'une mission" as UC_DETAIL_MISSION
    usecase "Preparer une intervention" as UC_PREPARER
    usecase "Effectuer un controle sur le terrain" as UC_CONTROLE
    usecase "Mettre a jour le statut d'une mission" as UC_STATUT_MISSION
    usecase "Ajouter une observation de terrain" as UC_OBSERVATION
    usecase "Creer un compteur si autorise" as UC_CREER_COMPTEUR
    usecase "Saisir un nouvel index" as UC_SAISIR_INDEX
    usecase "Corriger un releve autorise" as UC_CORRIGER_RELEVE
    usecase "Gerer ses notifications" as UC_NOTIFICATIONS
    usecase "Consulter les notifications archivees" as UC_ARCHIVES
    usecase "Generer et partager un releve PDF" as UC_PDF
    usecase "Consulter le journal d'activite" as UC_AUDIT
    usecase "Consulter le centre d'aide" as UC_AIDE
    usecase "Gerer ses preferences" as UC_PREFS
  }
}

' Fonctions accessibles aux trois profils selon les droits applicatifs documentes.
UTIL --> UC_AUTH
UTIL --> UC_LOGOUT
UTIL --> UC_PROFILE
UTIL --> UC_PASSWORD
ADMIN --> UC_ABONNES
RESP --> UC_ABONNES
AGENT --> UC_ABONNES
ADMIN --> UC_COMPTEURS
RESP --> UC_COMPTEURS
AGENT --> UC_COMPTEURS
ADMIN --> UC_HISTO
RESP --> UC_HISTO
AGENT --> UC_HISTO
ADMIN --> UC_ANOMALIES
RESP --> UC_ANOMALIES
AGENT --> UC_ANOMALIES

' Administrateur
ADMIN --> UC_USERS
ADMIN --> UC_GEST_ABONNES
ADMIN --> UC_GEST_COMPTEURS
ADMIN --> UC_DELETE_RELEVE
ADMIN --> UC_STATUT_FINAL

' Responsable
RESP --> UC_CAMPAGNE
RESP --> UC_DATES
RESP --> UC_AFFECTER
RESP --> UC_MISSIONS
RESP --> UC_PUBLIER
RESP --> UC_CLOTURER
RESP --> UC_SUIVI_MISSION
RESP --> UC_DASHBOARD
RESP --> UC_STATS
RESP --> UC_RELEVE_WEB

' Agent - application mobile
AGENT --> UC_MISSION_AGENT
AGENT --> UC_DETAIL_MISSION
AGENT --> UC_PREPARER
AGENT --> UC_CONTROLE
AGENT --> UC_STATUT_MISSION
AGENT --> UC_OBSERVATION
AGENT --> UC_CREER_COMPTEUR
AGENT --> UC_SAISIR_INDEX
AGENT --> UC_CORRIGER_RELEVE
AGENT --> UC_NOTIFICATIONS
AGENT --> UC_ARCHIVES
AGENT --> UC_PDF
AGENT --> UC_AUDIT
AGENT --> UC_AIDE
AGENT --> UC_PREFS

' Dependances metier strictement utiles
UC_RELEVE_WEB ..> UC_HISTO : <<include>>
UC_SAISIR_INDEX ..> UC_HISTO : <<include>>
UC_OBSERVATION ..> UC_CONTROLE : <<extend>>


