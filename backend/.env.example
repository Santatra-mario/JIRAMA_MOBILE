DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=jirama_db

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

PORT=5000
NODE_ENV=development

FRONTEND_URL=http://localhost:5173

# Jours fériés supplémentaires au format YYYY-MM-DD, séparés par des virgules.
JIRAMA_JOURS_FERIES=2026-12-25,2027-01-01

# Seuils de variation (%) utilisés par la détection d'anomalies de consommation.
# Règles techniques internes, à faire valider par le Responsable métier.
# JIRAMA_SEUIL_ANOMALIE=50
# JIRAMA_SEUIL_SUSPECTE=75
# JIRAMA_SEUIL_CRITIQUE=100
